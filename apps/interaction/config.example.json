{
  "asr": {
    "python": "<absolute-path-to-python>",
    "model": "<absolute-path-to-offline-faster-whisper-model>",
    "device": "cuda",
    "cudaBin": "<absolute-path-to-CUDA-and-cuDNN-dll-directory>"
  },
  "tts": {
    "provider": "sapi",
    "voice": "Microsoft Huihui Desktop",
    "qwenPython": "<absolute-path-to-python>",
    "qwenModel": "<absolute-path-to-local-qwen-model-or-GGUF-export-folder>",
