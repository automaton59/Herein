{
  "id": "netease",
  "name": "网易云音乐",
  "version": "0.3.0",
  "apiVersion": 1,
  "kind": "source",
  "description": "匿名只读网易云榜单/搜索，产出歌曲候选，供聊天和主动性推荐使用。",
  "setup": "不需要填任何东西：安装并启用后就会读取公开榜单。只有想改候选数量时才需要动配置。",
  "helpUrl": "docs/PLUGIN-SETUP.md#netease",
  "entry": "index.mjs",
  "permissions": [
    { "kind": "network", "value": "music.163.com", "reason": "读取公开榜单/搜索/歌词" }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "number",
        "title": "候选数量",
        "description": "每次刷新准备多少首候选歌曲，默认 10 首。",
        "default": 10,
        "minimum": 1,
        "maximum": 30
      }
    },
    "additionalProperties": false
  }
}
