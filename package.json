{
  "name": "herein",
  "version": "1.0.0",
  "description": "Herein, a local-first private IM companion desktop app",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "npm run check:core && npm run check:contrast && tsc && vite build",
    "check:core": "node scripts/check-core-boundaries.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:persona": "npm run electron:compile && node scripts/check-persona.mjs",
    "persona:seed": "npm run electron:compile && node scripts/seed-persona.mjs",
    "build:core": "npx tsc -p packages/core/tsconfig.json",
    "check:bilibili": "npx tsc -p adapters/bilibili/tsconfig.json --noEmit",
    "build:bilibili": "npx tsc -p adapters/bilibili/tsconfig.json",
    "check:netease": "npx tsc -p adapters/netease/tsconfig.json --noEmit",
    "build:netease": "npx tsc -p adapters/netease/tsconfig.json",
    "check:qq": "npx tsc -p adapters/qq/tsconfig.json --noEmit",
    "build:qq": "npx tsc -p adapters/qq/tsconfig.json",
    "test:dsh": "node --test adapters/dsh/test/*.test.mjs",
    "demo:dsh": "node adapters/dsh/scripts/demo.mjs",
    "serve:dsh": "node adapters/dsh/scripts/cli.mjs serve",
    "test:interaction": "node --test apps/interaction/tests/*.test.mjs",
    "build:interaction": "node apps/interaction/build.mjs",
    "bench:tts": "node scripts/benchmark_tts.mjs",
    "native:rebuild:node": "npm rebuild better-sqlite3",
    "test": "npm run native:rebuild:node && vitest",
    "test:run": "npm run native:rebuild:node && vitest run --passWithNoTests",
    "test:electron": "node scripts/run-tests-electron.cjs",
    "preview": "vite preview",
    "native:rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "core:serve": "npm run electron:compile && node dist-electron/core/server.js",
    "tunnel": "powershell -ExecutionPolicy Bypass -File scripts/start-core-tunnel.ps1",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:open": "npx cap open android",
    "electron:dev": "node scripts/run-electron-dev.cjs",
    "electron:build": "electron-builder",
    "electron:build:dir": "electron-builder --win --x64 --dir --config.directories.output=../Herein-Releases/Herein-1.0.0-win --config.win.signAndEditExecutable=false --config.electronDist=node_modules/electron/dist && node -e \"require('fs').copyFileSync('node_modules/electron/dist/electron.exe', '../Herein-Releases/Herein-1.0.0-win/win-unpacked/Herein.exe')\"",
    "qwen3-tts:serve": "python scripts/qwen3_tts_service.py --mode custom_voice --model tmp/models/qwen3-tts-customvoice --host 127.0.0.1 --port 9881 --no-flash-attn",
    "qwen3-tts-clone:serve": "python scripts/qwen3_tts_service.py --mode voice_clone --model tmp/models/qwen3-tts-base --host 127.0.0.1 --port 9882 --no-flash-attn",
    "start": "npm run native:rebuild:electron && npm run electron:compile && concurrently -k \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development npm run electron:dev\"",
    "postinstall": "npm run native:rebuild:electron"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electron/rebuild": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.3",
    "cross-env": "^7.0.3",
    "electron": "42.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "node-abi": "^4.40.0",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.21.0",
    "openai": "^6.42.0",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "zustand": "^5.0.14"
  }
}
